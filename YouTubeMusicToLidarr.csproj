<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>YouTubeMusicToLidarr</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="AppUI\index.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="AppUI\Gost1o1-logo.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="AppUI\flow918.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="AppUI\flow918.css" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
